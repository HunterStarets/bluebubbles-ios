<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>BlueBubbles iOS</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Connect</string>
			<key>footerText</key>
			<string>In the BlueBubbles client choose manual setup and enter this address and password. Open Messages once after each respring so the server can reach iMessage.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>label</key>
			<string>Server address</string>
			<key>get</key>
			<string>serverAddressForSpecifier:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>Password</string>
			<key>get</key>
			<string>passwordForSpecifier:</string>
			<key>set</key>
			<string>setPassword:forSpecifier:</string>
			<key>autoCapitalization</key>
			<string>none</string>
			<key>autoCorrection</key>
			<string>no</string>
			<key>keyboard</key>
			<string>default</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Server</string>
			<key>footerText</key>
			<string>Changes apply immediately; connected clients reconnect on their own.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Enabled</string>
			<key>key</key>
			<string>enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.hunterstarets.bluebubbles-ios</string>
			<key>PostNotification</key>
			<string>com.hunterstarets.bluebubbles-ios/settings</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>Port</string>
			<key>key</key>
			<string>port</string>
			<key>default</key>
			<integer>1234</integer>
			<key>defaults</key>
			<string>com.hunterstarets.bluebubbles-ios</string>
			<key>PostNotification</key>
			<string>com.hunterstarets.bluebubbles-ios/settings</string>
			<key>keyboard</key>
			<string>numbers</string>
			<key>isNumeric</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>HTTPS</string>
			<key>footerText</key>
			<string>Off by default; the desktop and Android clients work over plain HTTP on your network. Turn on for the web app, with your own PKCS#12 certificate at the path below (see docs/TLS.md). If the certificate cannot be loaded the server stays on HTTP.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Use HTTPS</string>
			<key>key</key>
			<string>tls</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.hunterstarets.bluebubbles-ios</string>
			<key>PostNotification</key>
			<string>com.hunterstarets.bluebubbles-ios/settings</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>Certificate</string>
			<key>key</key>
			<string>certificatePath</string>
			<key>placeholder</key>
			<string>/var/mobile/Library/BlueBubbles/server.p12</string>
			<key>defaults</key>
			<string>com.hunterstarets.bluebubbles-ios</string>
			<key>PostNotification</key>
			<string>com.hunterstarets.bluebubbles-ios/settings</string>
			<key>autoCapitalization</key>
			<string>none</string>
			<key>autoCorrection</key>
			<string>no</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>label</key>
			<string>Passphrase</string>
			<key>key</key>
			<string>certificatePassphrase</string>
			<key>isSecure</key>
			<true/>
			<key>defaults</key>
			<string>com.hunterstarets.bluebubbles-ios</string>
			<key>PostNotification</key>
			<string>com.hunterstarets.bluebubbles-ios/settings</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>About</string>
			<key>footerText</key>
			<string>BlueBubbles iOS is an unofficial BlueBubbles server for iOS 9. Not affiliated with the BlueBubbles project.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>GitHub: HunterStarets</string>
			<key>action</key>
			<string>openGitHub:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>label</key>
			<string>Version</string>
			<key>get</key>
			<string>versionForSpecifier:</string>
		</dict>
	</array>
</dict>
</plist>
